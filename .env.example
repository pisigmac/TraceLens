# Collector
COLLECTOR_PORT=8080
COLLECTOR_GRPC_PORT=50051
COLLECTOR_BUFFER_MS=100
COLLECTOR_MAX_SPANS_PER_BATCH=1000

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=tracelens
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=tracelens

# Auth
JWT_SECRET=change-me-in-production
JWT_ISSUER=tracelens
JWT_AUDIENCE=tracelens-api

# GuardLoop (external)
GUARDLOOP_ENABLED=false
GUARDLOOP_ENDPOINT=
GUARDLOOP_API_KEY=

# Features
FEATURE_REPLAY=true
FEATURE_COST_ATTRIBUTION=true
FEATURE_ANOMALY_DETECTION=true
FEATURE_GUARDLOOP=false

# Storage Tiers
HOT_RETENTION_DAYS=7
WARM_RETENTION_DAYS=30
COLD_STORAGE_BUCKET=

# Alerting
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=
